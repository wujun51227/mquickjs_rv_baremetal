#CONFIG_PROFILE=y
#CONFIG_X86_32=y
#CONFIG_ARM32=y
#CONFIG_WIN32=y
#CONFIG_SOFTFLOAT=y
#CONFIG_ASAN=y
#CONFIG_GPROF=y
CONFIG_SMALL=y

# RISC-V baremetal configuration
ifdef CONFIG_RISCV64_BAREMETAL
CROSS_PREFIX=riscv64-unknown-elf-
STD_CFG=
BAREMETAL=y
HEAP_SIZE?=16384
endif

ifdef CONFIG_RISCV32_BAREMETAL
CROSS_PREFIX=riscv32-unknown-elf-
BAREMETAL=y
STD_CFG=-m32
HEAP_SIZE?=16384
endif
# consider warnings as errors (for development)
#CONFIG_WERROR=y

ifdef CONFIG_ARM32
CROSS_PREFIX=arm-linux-gnu-
endif

ifdef CONFIG_WIN32
  ifdef CONFIG_X86_32
    CROSS_PREFIX?=i686-w64-mingw32-
  else
    CROSS_PREFIX?=x86_64-w64-mingw32-
  endif
  EXE=.exe
else
  CROSS_PREFIX?=
  EXE=
endif

HOST_CC=gcc
CC=$(CROSS_PREFIX)gcc
CFLAGS=-Wall -MMD -D_GNU_SOURCE -fno-math-errno -fno-trapping-math
HOST_CFLAGS=-Wall -g -MMD -D_GNU_SOURCE -fno-math-errno -fno-trapping-math
ifdef CONFIG_WERROR
CFLAGS+=-Werror
HOST_CFLAGS+=-Werror
endif
ifdef CONFIG_ARM32
CFLAGS+=-mthumb
endif
ifdef CONFIG_SMALL
CFLAGS+=-Os
else
CFLAGS+=-O2
endif
#CFLAGS+=-fstack-usage
ifdef CONFIG_SOFTFLOAT
CFLAGS+=-msoft-float
CFLAGS+=-DUSE_SOFTFLOAT
endif # CONFIG_SOFTFLOAT

ifdef CONFIG_RISCV64_BAREMETAL
CFLAGS+=-march=rv64imac -mabi=lp64 -mstrict-align -mcmodel=medany
CFLAGS+=-ffreestanding -nostdlib -fno-builtin
CFLAGS+=-DUSE_SOFTFLOAT
CFLAGS+=-DHEAP_SIZE=$(HEAP_SIZE)
LDFLAGS+=-nostdlib -nostartfiles -Wl,-T,./riscv/riscv64_baremetal.ld
LDFLAGS+=-Wl,--defsym=__heap_size=$(HEAP_SIZE)
endif # CONFIG_RISCV64_BAREMETAL

ifdef CONFIG_RISCV32_BAREMETAL
CFLAGS+=-march=rv32imac_zicsr -mabi=ilp32 -mstrict-align -mcmodel=medany
CFLAGS+=-ffreestanding -nostdlib -fno-builtin
CFLAGS+=-DUSE_SOFTFLOAT
CFLAGS+=-DHEAP_SIZE=$(HEAP_SIZE)
LDFLAGS+=-nostdlib -nostartfiles -Wl,-T,./riscv/riscv32_baremetal.ld
LDFLAGS+=-Wl,--defsym,__heap_size=$(HEAP_SIZE)
endif # CONFIG_RISCV32_BAREMETAL

# mcycle frequency in Hz; mcycle-derived time is relative, not Unix epoch time.
MCOUNTER_FREQ_HZ ?= 10000000ULL
ifdef BAREMETAL
CFLAGS+=-DMCOUNTER_FREQ_HZ=$(MCOUNTER_FREQ_HZ)
endif

# UART16550 base address for baremetal console output.
#   Default 0x10000000 (QEMU virt machine); e.g. make ... UART_BASE_ADDR=0x20000000
UART_BASE_ADDR ?= 0x10000000
ifdef BAREMETAL
CFLAGS+=-DUART_BASE_ADDR=$(UART_BASE_ADDR)
endif

# Host-compile test_code.js to bytecode.
#   Embedded:  CONFIG_BYTECODE=y
#   Mailbox:   CONFIG_BYTECODE_WAIT=y   (implies CONFIG_BYTECODE)
#   JSBYTECODE_ADDR ?= 0x80100000
#   BYTECODE_WAIT_SPINS ?= 0   (0 means wait forever)
#   CONFIG_BYTECODE_CHECKSUM ?= 1 (set to 0 to skip slot checksum)
ifdef CONFIG_BYTECODE_WAIT
CONFIG_BYTECODE=y
endif

# --- Per-configuration build isolation -------------------------------
# Every baremetal configuration gets its own output tree so objects built
# with one architecture/ABI/feature set can never be reused by another:
#
#   build/riscv32        default RV32 firmware
#   build/riscv64        default RV64 firmware
#   build/riscv32-bc     RV32 with embedded bytecode (CONFIG_BYTECODE=y)
#   build/riscv64-bc     RV64 with embedded bytecode (CONFIG_BYTECODE=y)
#   build/riscv32-wait   RV32 mailbox/late load   (CONFIG_BYTECODE_WAIT=y)
#   build/riscv64-wait   RV64 mailbox/late load   (CONFIG_BYTECODE_WAIT=y)
#
# Objects, the host bytecode generator, the generated headers and the ELF
# all live inside the tree.  The generated mqjs_stdlib.h/mquickjs_atom.h
# depend on $(STD_CFG), so they are per-target outputs, not shared files.
# Override with BUILD_DIR=<path> on the command line if needed.
ifdef BAREMETAL
BUILD_ARCH=riscv-unknown
ifdef CONFIG_RISCV64_BAREMETAL
BUILD_ARCH=riscv64
endif
ifdef CONFIG_RISCV32_BAREMETAL
BUILD_ARCH=riscv32
endif
BUILD_MODE=
ifneq ($(CONFIG_BYTECODE_WAIT),)
BUILD_MODE=-wait
else ifneq ($(CONFIG_BYTECODE),)
BUILD_MODE=-bc
endif
BUILD_DIR ?= build/$(BUILD_ARCH)$(BUILD_MODE)
# Quoted includes such as "mqjs_stdlib.h" must resolve to the
# per-configuration generated headers, never to a stale root-level copy
# left behind by a host-mode build.
CFLAGS+=-I$(BUILD_DIR)
# -I. recovers the (source-controlled) engine headers referenced by the
# generated mqjs_stdlib.h; -I$(BUILD_DIR) keeps generated headers winning
# over any stale root-level copies.
CFLAGS+=-I.
# Compile/link parameter fingerprints (rules at the bottom of this file).
# Every target object explicitly depends on the cflags stamp, every link on
# the ldflags stamp, so changing any build parameter (HEAP_SIZE,
# JSBYTECODE_ADDR, MCOUNTER_FREQ_HZ, UART_BASE_ADDR, toolchain, ...) or this
# makefile rebuilds exactly the affected artifacts instead of silently
# reusing objects compiled with different flags.
CFLAGS_STAMP=$(BUILD_DIR)/.cflags
LDFLAGS_STAMP=$(BUILD_DIR)/.ldflags
HOST_CFLAGS_STAMP=$(BUILD_DIR)/.host-cflags
endif # BAREMETAL

ifdef CONFIG_BYTECODE
CFLAGS+=-DCONFIG_BYTECODE
ifdef CONFIG_BYTECODE_CHECKSUM
CFLAGS+=-DCONFIG_BYTECODE_CHECKSUM=$(CONFIG_BYTECODE_CHECKSUM)
endif
JSBYTECODE_ADDR ?= 0x80100000
LDFLAGS+=-Wl,--defsym,__jsbytecode_addr=$(JSBYTECODE_ADDR)
LDFLAGS+=-Wl,--section-start=.jsbytecode=$(JSBYTECODE_ADDR)
# Host-side bytecode compiler tree, isolated per configuration because the
# generated headers and the -m32/-m64 codegen differ between RV32 and RV64.
HOST_BUILD=$(BUILD_DIR)/host
JS_TO_BC=$(HOST_BUILD)/js_to_bc
ifdef CONFIG_RISCV32_BAREMETAL
JS_TO_BC_FLAGS=-m32
endif
ifdef CONFIG_BYTECODE_WAIT
CFLAGS+=-DCONFIG_BYTECODE_WAIT
JSBYTECODE_SIZE ?= 8192
BYTECODE_WAIT_SPINS ?= 0
CFLAGS+=-DBYTECODE_WAIT_SPINS=$(BYTECODE_WAIT_SPINS)
LDFLAGS+=-Wl,--defsym,__jsbytecode_size=$(JSBYTECODE_SIZE)
endif
endif # CONFIG_BYTECODE

HOST_CFLAGS+=-O2
#LDFLAGS+=-g
HOST_LDFLAGS=-g
ifdef CONFIG_GPROF
CFLAGS+=-p
LDFLAGS+=-p
endif
ifdef CONFIG_ASAN
CFLAGS+=-fsanitize=address -fno-omit-frame-pointer
LDFLAGS+=-fsanitize=address -fno-omit-frame-pointer
endif
ifdef CONFIG_X86_32
CFLAGS+=-m32
LDFLAGS+=-m32
endif
ifdef CONFIG_PROFILE
CFLAGS+=-p
LDFLAGS+=-p
endif

# when cross compiling from a 64 bit system to a 32 bit system, force
# a 32 bit output
ifdef CONFIG_X86_32
MQJS_BUILD_FLAGS=-m32
endif
ifdef CONFIG_ARM32
MQJS_BUILD_FLAGS=-m32
endif

PROGS=mqjs$(EXE) example$(EXE)
TEST_PROGS=dtoa_test libm_test

ifdef CONFIG_RISCV64_BAREMETAL
PROGS=$(BUILD_DIR)/mqjs_baremetal.elf
endif 

ifdef CONFIG_RISCV32_BAREMETAL
PROGS=$(BUILD_DIR)/mqjs_baremetal.elf
endif 

all: $(PROGS)

MQJS_OBJS=mqjs.o readline_tty.o readline.o mquickjs.o dtoa.o libm.o cutils.o
LIBS=-lm

ifdef BAREMETAL
ifdef CONFIG_RISCV64_BAREMETAL
MQJS_BAREMETAL_OBJS=$(BUILD_DIR)/riscv/mqjs_baremetal.o $(BUILD_DIR)/riscv/baremetal_syscall_rv64.o $(BUILD_DIR)/mquickjs.o $(BUILD_DIR)/dtoa.o $(BUILD_DIR)/libm.o $(BUILD_DIR)/cutils.o $(BUILD_DIR)/riscv/start_riscv64.o
endif
ifdef CONFIG_RISCV32_BAREMETAL
MQJS_BAREMETAL_OBJS=$(BUILD_DIR)/riscv/mqjs_baremetal.o $(BUILD_DIR)/riscv/baremetal_syscall_rv32.o $(BUILD_DIR)/mquickjs.o $(BUILD_DIR)/dtoa.o $(BUILD_DIR)/libm.o $(BUILD_DIR)/cutils.o $(BUILD_DIR)/riscv/start_riscv32.o
endif
ifdef CONFIG_BYTECODE
ifndef CONFIG_BYTECODE_WAIT
MQJS_BAREMETAL_OBJS+=$(BUILD_DIR)/jsbytecode.o
endif
endif
else
MQJS_BAREMETAL_OBJS=
endif

mqjs$(EXE): $(MQJS_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

ifdef CONFIG_BYTECODE
ifndef CONFIG_BYTECODE_WAIT
$(BUILD_DIR)/mqjs_baremetal.elf: $(BUILD_DIR)/jsbytecode.o $(BUILD_DIR)/test_code.bin
else
$(BUILD_DIR)/mqjs_baremetal.elf: $(BUILD_DIR)/test_code.slot
endif
endif

ifdef CONFIG_RISCV64_BAREMETAL
$(BUILD_DIR)/mqjs_baremetal.elf: $(LDFLAGS_STAMP) $(CFLAGS_STAMP) $(BUILD_DIR)/mqjs_stdlib.h $(MQJS_BAREMETAL_OBJS) ./riscv/riscv64_baremetal.ld
	$(CC) $(LDFLAGS) $(CFLAGS) -o $@ $(MQJS_BAREMETAL_OBJS) 
endif

ifdef CONFIG_RISCV32_BAREMETAL
$(BUILD_DIR)/mqjs_baremetal.elf: $(LDFLAGS_STAMP) $(CFLAGS_STAMP) $(BUILD_DIR)/mqjs_stdlib.h $(MQJS_BAREMETAL_OBJS) $(BUILD_DIR)/riscv/shift_rv32.o ./riscv/riscv32_baremetal.ld
	$(CC) $(LDFLAGS) $(CFLAGS) -o $@ $(MQJS_BAREMETAL_OBJS) $(BUILD_DIR)/riscv/shift_rv32.o
endif

# mqjs_baremetal.c includes the generated mqjs_stdlib.h and mquickjs.c the
# generated mquickjs_atom.h; without these explicit dependencies a clean
# parallel build compiles the objects before the headers are generated.
ifdef BAREMETAL
$(BUILD_DIR)/riscv/mqjs_baremetal.o: $(BUILD_DIR)/mqjs_stdlib.h

# mquickjs.c is compiled from a copy inside $(BUILD_DIR) so its quoted
# include of "mquickjs_atom.h" resolves to the per-configuration generated
# header (atom tables differ between RV32 and RV64), never to a stale
# root-level one produced by a host build.  The explicit dependencies also
# make clean parallel builds safe.
$(BUILD_DIR)/mquickjs.c: mquickjs.c
	@mkdir -p $(dir $@)
	cp $< $@

$(BUILD_DIR)/mquickjs.o: $(BUILD_DIR)/mquickjs.c $(BUILD_DIR)/mquickjs_atom.h $(CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $(BUILD_DIR)/mquickjs.c

# Per-configuration host bytecode-generator tool and generated headers.
# The target headers are generated with $(STD_CFG) (-m32 for RV32) because
# atom tables differ between RV32 and RV64.
$(BUILD_DIR)/mqjs_stdlib: $(BUILD_DIR)/mqjs_stdlib.host.o $(BUILD_DIR)/mquickjs_build.host.o
	@mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_LDFLAGS) -o $@ $^

$(BUILD_DIR)/mquickjs_atom.h: $(BUILD_DIR)/mqjs_stdlib
	@mkdir -p $(dir $@)
	$(BUILD_DIR)/mqjs_stdlib $(STD_CFG) -a $(MQJS_BUILD_FLAGS) > $@

$(BUILD_DIR)/mqjs_stdlib.h: $(BUILD_DIR)/mqjs_stdlib
	@mkdir -p $(dir $@)
	$(BUILD_DIR)/mqjs_stdlib $(STD_CFG) $(MQJS_BUILD_FLAGS) > $@
endif # BAREMETAL

# Host (non-baremetal) builds keep the legacy root-level outputs.
mqjs_stdlib: mqjs_stdlib.host.o mquickjs_build.host.o
	$(HOST_CC) $(HOST_LDFLAGS) -o $@ $^

mquickjs_atom.h: mqjs_stdlib
	./mqjs_stdlib $(STD_CFG) -a $(MQJS_BUILD_FLAGS) > $@

mqjs_stdlib.h: mqjs_stdlib
	./mqjs_stdlib $(STD_CFG) $(MQJS_BUILD_FLAGS) > $@

ifdef CONFIG_BYTECODE
ifdef BAREMETAL
$(BUILD_DIR)/host/mquickjs.c: mquickjs.c
	@mkdir -p $(dir $@)
	cp $< $@

$(BUILD_DIR)/host/mquickjs_atom.h: $(BUILD_DIR)/mqjs_stdlib
	@mkdir -p $(dir $@)
	$(BUILD_DIR)/mqjs_stdlib -a > $@

$(BUILD_DIR)/host/mqjs_stdlib.h: $(BUILD_DIR)/mqjs_stdlib
	@mkdir -p $(dir $@)
	$(BUILD_DIR)/mqjs_stdlib > $@

$(BUILD_DIR)/host/mquickjs.o: $(BUILD_DIR)/host/mquickjs.c $(BUILD_DIR)/host/mquickjs_atom.h $(HOST_CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) -I$(BUILD_DIR)/host -I. -c -o $@ $(BUILD_DIR)/host/mquickjs.c

$(BUILD_DIR)/host/js_to_bc.o: riscv/js_to_bc.c riscv/jsbytecode_slot.h $(BUILD_DIR)/host/mqjs_stdlib.h $(HOST_CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) -I$(BUILD_DIR)/host -I. -c -o $@ riscv/js_to_bc.c

$(BUILD_DIR)/host/%.host.o: %.c $(HOST_CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) -c -o $@ $<

$(JS_TO_BC): $(BUILD_DIR)/host/js_to_bc.o $(BUILD_DIR)/host/mquickjs.o $(BUILD_DIR)/host/cutils.host.o $(BUILD_DIR)/host/dtoa.host.o $(BUILD_DIR)/host/libm.host.o
	$(HOST_CC) $(HOST_LDFLAGS) -o $@ $^ -lm

$(BUILD_DIR)/test_code.bin: riscv/test_code.js $(JS_TO_BC)
	@mkdir -p $(dir $@)
	$(JS_TO_BC) $(JS_TO_BC_FLAGS) -o $@ $<

$(BUILD_DIR)/test_code.slot: $(BUILD_DIR)/test_code.bin $(JS_TO_BC)
	@mkdir -p $(dir $@)
	$(JS_TO_BC) --wrap-slot -o $@ $<

$(BUILD_DIR)/jsbytecode.s: $(BUILD_DIR)/test_code.bin
	@mkdir -p $(dir $@)
	( echo ".section .jsbytecode, \"aw\", @progbits"; \
	  echo ".balign 8"; \
	  echo ".globl __jsbytecode_start"; \
	  echo ".globl __jsbytecode_end"; \
	  echo "__jsbytecode_start:"; \
	  echo ".incbin \"$<\""; \
	  echo "__jsbytecode_end:" ) > $@

$(BUILD_DIR)/jsbytecode.o: $(BUILD_DIR)/jsbytecode.s $(CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
endif # BAREMETAL
endif # CONFIG_BYTECODE

mqjs.o: mqjs_stdlib.h

# C API example
example.o: example_stdlib.h

example$(EXE): example.o mquickjs.o dtoa.o libm.o cutils.o
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

example_stdlib: example_stdlib.host.o mquickjs_build.host.o
	$(HOST_CC) $(HOST_LDFLAGS) -o $@ $^

example_stdlib.h: example_stdlib
	./example_stdlib $(MQJS_BUILD_FLAGS) > $@

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.s
	$(CC) $(CFLAGS) -c -o $@ $<

ifdef BAREMETAL
# Per-configuration objects; the cflags stamp is an explicit dependency so
# any compile-parameter change forces a rebuild.
$(BUILD_DIR)/%.host.o: %.c $(HOST_CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(HOST_CC) $(HOST_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/%.o: %.c $(CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/%.o: %.s $(CFLAGS_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
endif # BAREMETAL

%.host.o: %.c
	$(HOST_CC) $(HOST_CFLAGS) -c -o $@ $<

test: mqjs example
	./mqjs tests/test_closure.js
	./mqjs tests/test_language.js
	./mqjs tests/test_loop.js
	./mqjs tests/test_builtin.js
# test bytecode generation and loading
	./mqjs -o test_builtin.bin tests/test_builtin.js
#	@sha256sum -c test_builtin.sha256
	./mqjs -b test_builtin.bin
	./example tests/test_rect.js

microbench: mqjs
	./mqjs tests/microbench.js

octane: mqjs
	./mqjs --memory-limit 256M tests/octane/run.js

size: mqjs
	size mqjs mqjs.o readline.o cutils.o dtoa.o libm.o mquickjs.o

dtoa_test: tests/dtoa_test.o dtoa.o cutils.o tests/gay-fixed.o tests/gay-precision.o tests/gay-shortest.o
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

libm_test: tests/libm_test.o libm.o
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

rempio2_test: tests/rempio2_test.o libm.o
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

RISCV32_CC ?= riscv32-unknown-elf-gcc
QEMU_SYSTEM_RISCV32 ?= qemu-system-riscv32

# Host oracle vs native 64-bit shifts, then RV32 assembly vs the same oracle.
riscv/test_shift_ref_host: riscv/test_shift_rv32.c
	$(HOST_CC) -O0 -Wall -DHOST_TEST -o $@ $<

riscv/test_shift_rv32.elf: riscv/test_shift_rv32.c riscv/shift_rv32.s riscv/start_riscv32.s riscv/riscv32_baremetal.ld
	$(RISCV32_CC) -march=rv32imac_zicsr -mabi=ilp32 -mstrict-align -mcmodel=medany \
	  -ffreestanding -nostdlib -fno-builtin -O0 -Wall \
	  -Wl,-T,./riscv/riscv32_baremetal.ld \
	  -o $@ riscv/start_riscv32.s riscv/shift_rv32.s riscv/test_shift_rv32.c

.PHONY: test-shift-host test-shift-rv32
test-shift-host: riscv/test_shift_ref_host
	./riscv/test_shift_ref_host

test-shift-rv32: test-shift-host riscv/test_shift_rv32.elf
	timeout --foreground 8 $(QEMU_SYSTEM_RISCV32) -machine virt -cpu rv32 -nographic -bios none \
	  -kernel riscv/test_shift_rv32.elf -m 4M

clean:
	rm -rf build host_build
	rm -f riscv/*.o riscv/*.d riscv/ready.bin riscv/jsbytecode.s riscv/test_code.bin riscv/test_code.slot riscv/test_shift_rv32.elf riscv/test_shift_ref_host *.o *.d *~ tests/*.o tests/*.d tests/*~ test_builtin.bin mqjs_stdlib mqjs_stdlib.h mquickjs_build_atoms mquickjs_atom.h mqjs_example example_stdlib example_stdlib.h $(PROGS) $(TEST_PROGS) mqjs_baremetal.elf

# --- Explicit build-parameter dependency stamps ----------------------
# Each stamp stores the signature of the corresponding command line.  It is
# rewritten (mtime bumped) only when the signature changes, so an unchanged
# incremental build stays a no-op, while any parameter change - or an edit
# of this makefile, via $(MAKEFILE_LIST) - forces the dependent objects and
# links to be redone.
.PHONY: FORCE
FORCE:

$(CFLAGS_STAMP): $(MAKEFILE_LIST) FORCE
	@mkdir -p $(dir $@)
	@printf 'CC=%s\nCFLAGS=%s\n' '$(CC)' '$(CFLAGS)' | cmp -s - $@ || \
	  printf 'CC=%s\nCFLAGS=%s\n' '$(CC)' '$(CFLAGS)' > $@

$(LDFLAGS_STAMP): $(MAKEFILE_LIST) FORCE
	@mkdir -p $(dir $@)
	@printf 'CC=%s\nLDFLAGS=%s\n' '$(CC)' '$(LDFLAGS)' | cmp -s - $@ || \
	  printf 'CC=%s\nLDFLAGS=%s\n' '$(CC)' '$(LDFLAGS)' > $@

$(HOST_CFLAGS_STAMP): $(MAKEFILE_LIST) FORCE
	@mkdir -p $(dir $@)
	@printf 'HOST_CC=%s\nHOST_CFLAGS=%s\n' '$(HOST_CC)' '$(HOST_CFLAGS)' | cmp -s - $@ || \
	  printf 'HOST_CC=%s\nHOST_CFLAGS=%s\n' '$(HOST_CC)' '$(HOST_CFLAGS)' > $@

-include $(wildcard *.d)
ifneq ($(BUILD_DIR),)
-include $(wildcard $(BUILD_DIR)/*.d $(BUILD_DIR)/riscv/*.d $(BUILD_DIR)/host/*.d)
endif
