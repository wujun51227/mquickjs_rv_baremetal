+int __ctzdi2(uint64_t x) {
+    int n = 0;
+    if ((x & 0xFFFFFFFF) == 0) { n += 32; x >>= 32; }
+    if ((x & 0xFFFF) == 0) { n += 16; x >>= 16; }
+    if ((x & 0xFF) == 0) { n += 8; x >>= 8; }
+    if ((x & 0xF) == 0) { n += 4; x >>= 4; }
+    if ((x & 0x3) == 0) { n += 2; x >>= 2; }
+    if ((x & 0x1) == 0) { n += 1; }
+    return n;
