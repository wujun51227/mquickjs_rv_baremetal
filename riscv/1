+    /* Generic long division using restorative algorithm */
+    for (i = 63; i >= 0; i--) {
+        r = (r << 1) | ((x >> i) & 1);
+        if (r >= n) {
+            r -= n;
+            q |= ((udi_int)1 << i);
+        }
+    }
+    return q;
