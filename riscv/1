+    udi_int xu = (udi_int)x;
+    udi_int nu = (udi_int)n;
+    if (x < 0) { neg = 1; xu = -xu; }
+    if (n < 0) { neg ^= 1; nu = -nu; }
+    udi_int result = __udivdi3(xu, nu);
+    return neg ? -(di_int)result : (di_int)result;
